# Neon pooled connection string — see "Database setup" in CLAUDE.md
DATABASE_URL=

# better-auth reads this automatically to sign sessions/cookies
BETTER_AUTH_SECRET=

# Used to build invite links and as the auth baseURL. Set this locally to
# match the dev server's actual origin (http://localhost:3010 — see the
# pinned -p 3010 in package.json's "dev" script) — if it doesn't match
# what the browser sends as Origin, better-auth rejects sign-in with a 403
# INVALID_ORIGIN. Falls back to http://localhost:3000 if unset, but must
# be set explicitly in production.
NEXT_PUBLIC_APP_URL=

# Local-only test accounts (role "member" on Codestash) for exercising
# permission checks — see scripts/create-test-members.ts
TEST_MEMBER_1_EMAIL=
TEST_MEMBER_1_PASSWORD=
TEST_MEMBER_2_EMAIL=
TEST_MEMBER_2_PASSWORD=
TEST_MEMBER_3_EMAIL=
TEST_MEMBER_3_PASSWORD=

# Local-only test account that owns its own second org (plan "A"), for
# verifying org isolation — see scripts/create-test-second-org.ts
TEST_OWNER_2_EMAIL=
TEST_OWNER_2_PASSWORD=
